digraph model_graph {
  // Dotfile by Django-Extensions graph_models
  // Created: 2026-03-30 21:33
  // Cli Options: api -g --dot -o model.dot

  fontname = "Roboto"
  fontsize = 8
  splines  = true
  rankdir = "TB"
  

  node [
    fontname = "Roboto"
    fontsize = 8
    shape = "plaintext"
